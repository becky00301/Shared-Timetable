NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GTM_ID=
# Set to 1 only once the Google provider is enabled in Supabase and a client
# exists in Google Cloud. It reveals the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_AUTH=
# Maps JavaScript API + Geocoding API. Restrict it by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
